+struct pin_result_ind {
+	uint8_t pwr_pin_result_valid;
+	uint32_t pwr_pin_result;
+	uint8_t phy_io_pin_result_valid;
+	uint32_t phy_io_pin_result;
+	uint8_t rf_pin_result_valid;
+	uint32_t rf_pin_result;
+};
+static const struct qmi_elem_info pin_result_ind_ei[] = {
+	EI_OPT(struct pin_result_ind, pwr_pin_result, 0x10), EI_U32(struct pin_result_ind, pwr_pin_result, 0x10),
+	EI_OPT(struct pin_result_ind, phy_io_pin_result, 0x11), EI_U32(struct pin_result_ind, phy_io_pin_result, 0x11),
+	EI_OPT(struct pin_result_ind, rf_pin_result, 0x12), EI_U32(struct pin_result_ind, rf_pin_result, 0x12),
+	EI_END,
