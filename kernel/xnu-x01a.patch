+
+/* ---- the handle, and what the firmware says by itself ------------------------------------------------- */
+
+static struct qmi_handle handle;
+static struct {
+	volatile bool server, gone, fw_ready, msa_ready, pins;
+	uint64_t began;
+	uint32_t step;
+} wcn;
+
+static uint64_t
+now_ms(void)
+{
+	uint64_t nanoseconds;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &nanoseconds);
+	return nanoseconds / 1000000;
+}
+
+static int
+wcn_new_server(struct qmi_handle *qmi, struct qmi_service *service)
+{
+	int error = hakios_qmi_connect(qmi->sock, service->node, service->port);
+
+	printf("wcn3990: %u: the service is at node %u port %u (service %#x, version %u, instance %u)%s\n", wcn.step,
+	    service->node, service->port, service->service, service->version, service->instance,
+	    error ? ": CANNOT BE CONNECTED TO" : "");
+	wcn.server = error == 0;
+	return error;
+}
+
+static void
+wcn_del_server(__unused struct qmi_handle *qmi, struct qmi_service *service)
+{
+	printf("wcn3990: %u: THE SERVICE AT NODE %u PORT %u HAS GONE\n", wcn.step, service->node, service->port);
+	wcn.gone = true;
+}
+
+static void
+wcn_fw_ready(__unused struct qmi_handle *qmi, __unused struct sockaddr_qrtr *sq, __unused struct qmi_txn *txn,
+    __unused const void *decoded)
+{
+	wcn.fw_ready = true;
+	printf("wcn3990: %u: +%llu ms: THE FIRMWARE SAYS \"firmware ready\"\n", wcn.step, now_ms() - wcn.began);
+}
+
+static void
+wcn_msa_ready(__unused struct qmi_handle *qmi, __unused struct sockaddr_qrtr *sq, __unused struct qmi_txn *txn,
+    __unused const void *decoded)
+{
+	wcn.msa_ready = true;
+	printf("wcn3990: %u: +%llu ms: the firmware says \"MSA ready\"\n", wcn.step, now_ms() - wcn.began);
+}
+
+static void
+wcn_pins(__unused struct qmi_handle *qmi, __unused struct sockaddr_qrtr *sq, __unused struct qmi_txn *txn, const void *decoded)
+{
+	const struct pin_result_ind *pins = decoded;
+
+	wcn.pins = true;
+	printf("wcn3990: %u: +%llu ms: the pins' result: power %#x%s, PHY I/O %#x%s, RF %#x%s\n", wcn.step, now_ms() - wcn.began,
+	    pins->pwr_pin_result, pins->pwr_pin_result_valid ? "" : " (not said)", pins->phy_io_pin_result,
+	    pins->phy_io_pin_result_valid ? "" : " (not said)", pins->rf_pin_result, pins->rf_pin_result_valid ? "" : " (not said)");
+}
+
+static const struct qmi_ops wcn_ops = { .new_server = wcn_new_server, .del_server = wcn_del_server };
+static const struct qmi_msg_handler wcn_handlers[] = {
+	{ QMI_INDICATION, WLFW_FW_READY_IND, empty_req_ei, sizeof(struct empty_req), wcn_fw_ready },
+	{ QMI_INDICATION, WLFW_MSA_READY_IND, empty_req_ei, sizeof(struct empty_req), wcn_msa_ready },
+	{ QMI_INDICATION, WLFW_PIN_CONNECT_IND, pin_result_ind_ei, sizeof(struct pin_result_ind), wcn_pins },
+	{ 0 },
+};
+
+/*
+ * How far the exchange has got, painted on the screen (boot-arg wcn3990_marks=1): one band of colour per
+ * point passed, repainted every few milliseconds over whatever the system draws. A run that ends the
+ * phone loses its log, and the panel keeps the last frame: a photograph of it says where the end was.
+ * The framebuffer is the loader's (0xa0000000, 1080 x 1920, 4 bytes a pixel, as on this phone); only the strip
+ * of it the bands are in is mapped.
+ */
+#define FB_PHYS                 0xa0000000ul
+#define FB_WIDTH                1080
+#define FB_HEIGHT               1920
+#define MARK_TOP                300
+#define MARK_HEIGHT             30
+#define MARK_GAP                10
+#define MARKS                   10
+
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t thread_terminate(thread_t thread);
+
+static volatile uint32_t *fb;
+static volatile uint32_t marks;
+static volatile bool marking;
+
+/* BGRx: white, red, green, blue, yellow, cyan, magenta, orange, grey, white */
+static const uint32_t mark_colour[] = { 0xffffff, 0xff0000, 0x00ff00, 0x0000ff, 0xffff00, 0x00ffff, 0xff00ff, 0xff8000, 0x808080,
+	                                    0xffffff };
+
+static void
+mark_paint(void)
+{
+	for (uint32_t m = 0; m < marks && m < sizeof(mark_colour) / sizeof(mark_colour[0]); m++) {
+		for (uint32_t y = m * (MARK_HEIGHT + MARK_GAP); y < m * (MARK_HEIGHT + MARK_GAP) + MARK_HEIGHT; y++) {
+			for (uint32_t x = 0; x < FB_WIDTH; x++) {
+				fb[y * FB_WIDTH + x] = mark_colour[m];
+			}
+		}
+	}
+}
+
+static void
+mark_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	while (marking) {
+		mark_paint();
+		delay_for_interval(20, NSEC_PER_MSEC);
+	}
+	thread_terminate(current_thread());
+}
+
+static void
+mark(void)
+{
+	if (fb != NULL) {
+		marks++;
+		mark_paint();
+		printf("wcn3990: %u: mark %u painted\n", wcn.step, marks);
+	}
+}
+
+static void
+marks_start(void)
+{
+	thread_t thread;
+	uint32_t on = 0;
+
+	if (!PE_parse_boot_argn("wcn3990_marks", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	/* only the strip the bands are in: the whole framebuffer (8 MB) is more than the kernel's map has to spare */
+	fb = (volatile uint32_t *)ml_io_map_wcomb(FB_PHYS + (vm_offset_t)MARK_TOP * FB_WIDTH * 4,
+	    (vm_size_t)FB_WIDTH * 4 * MARKS * (MARK_HEIGHT + MARK_GAP));
+	if (fb == NULL) {
+		return;
+	}
+	marks = 0;
+	marking = true;
+	if (kernel_thread_start(mark_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+static bool
+wait_for(volatile bool *flag, uint32_t ms)
+{
+	for (uint32_t i = 0; i < ms && !*flag && !wcn.gone; i++) {
+		delay_for_interval(1, NSEC_PER_MSEC);
+	}
+	return *flag;
+}
+
+/* One request and its reply; `reply` begins with the result. True: the firmware said "success". */
+static bool
+ask(const char *what, int message, const struct qmi_elem_info *request_ei, const void *request,
+    const struct qmi_elem_info *reply_ei, void *reply, bool quiet)
+{
+	const struct qmi_response_type_v01 *result = reply;
+	struct qmi_txn txn;
+	uint64_t began = now_ms();
+	int ret = qmi_txn_init(&handle, &txn, reply_ei, reply);
+
+	if (ret >= 0) {
+		ret = qmi_send_request(&handle, NULL, &txn, message, WLFW_LARGEST, request_ei, request);
+		if (ret < 0) {
+			qmi_txn_cancel(&txn);
+		} else {
+			ret = hakios_qmi_txn_wait_ms(&txn, WLFW_TIMEOUT_MS);
+		}
+	}
+	if (ret >= 0 && result->result == QMI_RESULT_SUCCESS_V01) {
+		if (!quiet) {
+			printf("wcn3990: %u: %s (message %#x): success, after %llu ms\n", wcn.step, what, message, now_ms() - began);
+		}
+		return true;
+	}
+	if (ret < 0) {
+		printf("wcn3990: %u: %s (message %#x): NO ANSWER THAT CAN BE READ: %d, after %llu ms\n", wcn.step, what, message, ret,
+		    now_ms() - began);
+	} else {
+		printf("wcn3990: %u: %s (message %#x): THE FIRMWARE REFUSES: result %u, error %u, after %llu ms\n", wcn.step, what,
+		    message, result->result, result->error, now_ms() - began);
+	}
+	return false;
+}
+
+/* The board's data file for that board id, as Android's driver names it; the generic one if there is no such file. */
+static bool
+send_board(uint32_t board_id, bool board_id_known)
+{
+	static struct bdf_req request;
+	struct result_resp reply;
+	char name[32];
+	uint64_t size = 0, began = now_ms();
+	uint8_t *data = NULL;                   /* hakios_mpss_file()'s memory, given back below */
+	const uint8_t *at;
+	uint32_t left, pieces = 0;
+
+	if (board_id_known && board_id != 0xff) {
+		snprintf(name, sizeof(name), board_id < 0x100 ? "image/bdwlan.b%02x" : "image/bdwlan.%03x", board_id);
+		data = __DECONST(uint8_t *, hakios_mpss_file(name, &size));
+		if (data == NULL) {
+			printf("wcn3990: %u: no fw/%s: the generic board file instead\n", wcn.step, name);
+		}
+	}
+	if (data == NULL) {
+		strlcpy(name, "image/bdwlan.bin", sizeof(name));
+		data = __DECONST(uint8_t *, hakios_mpss_file(name, &size));
+	}
+	if (data == NULL || size == 0 || size > 1024 * 1024) {
+		printf("wcn3990: %u: no board file (fw/%s, %llu bytes): nothing sent\n", wcn.step, name, size);
+		if (data != NULL) {
+			kfree_data(data, size);
+		}
+		return false;
+	}
+	printf("wcn3990: %u: the board file: fw/%s, %llu bytes, beginning %02x %02x %02x %02x\n", wcn.step, name, size, data[0],
+	    data[1], data[2], data[3]);
+	bzero(&request, sizeof(request));
+	for (at = data, left = (uint32_t)size; left > 0; pieces++) {
+		request.valid = 1;
+		request.file_id_valid = 1;
+		request.file_id = 0;
+		request.total_size_valid = 1;
+		request.total_size = (uint32_t)size;
+		request.seg_id_valid = 1;
+		request.data_valid = 1;
+		request.end_valid = 1;
+		request.end = left <= WLFW_MAX_DATA;
+		request.data_len = request.end ? left : WLFW_MAX_DATA;
+		memcpy(request.data, at, request.data_len);
+		bzero(&reply, sizeof(reply));
+		if (!ask("a piece of the board file", WLFW_BDF_DOWNLOAD, bdf_req_ei, &request, result_resp_ei, &reply, true)) {
+			printf("wcn3990: %u: the board file: REFUSED AT PIECE %u (%u bytes still to go)\n", wcn.step, pieces, left);
+			kfree_data(data, size);
+			return false;
+		}
+		left -= request.data_len;
+		at += request.data_len;
+		request.seg_id++;
+	}
+	kfree_data(data, size);
+	printf("wcn3990: %u: THE BOARD FILE IS TAKEN: %u pieces in %llu ms\n", wcn.step, pieces, now_ms() - began);
+	return true;
+}
+
+/*
+ * The radio's supplies on, as ath10k's ath10k_snoc_vreg_on() turns them on before it speaks to the
+ * firmware: in its order, at the voltages of the phone's device tree (qcom,icnss: vdd-cx-mx, vdd-1.8-xo,
+ * vdd-1.3-rfa, vdd-3.3-ch0, vdd-3.3-ch1, and the bt_wcn3990 node's levels for the same rails), each in
+ * high-power mode, through RPMh. They are left on when the run ends: RPMh adds our vote to the others'
+ * (the boot loader's among them), and the next boot starts afresh.
+ */
+#define VRM_VOLTAGE             0
+#define VRM_ENABLE              4
+#define VRM_MODE                8
+#define VRM_MODE_HPM            7               /* Linux: RPMH_REGULATOR_MODE_HPM of a PMIC4/5 LDO */
+
+static bool
+power_on(uint32_t step)
+{
+	static const struct {
+		const char *supply, *resource;
+		uint32_t millivolts;            /* 0: as it is */
+	} rails[] = {
+		{ "vdd-cx-mx", "ldoa1", 0 },            /* pm8150 l1 */
+		{ "vdd-1.8-xo", "ldoa14", 1800 },       /* pm8150 l14 */
+		{ "vdd-1.3-rfa", "ldoc2", 1304 },       /* pm8150a l2 */
+		{ "vdd-3.3-ch0", "ldoc10", 3000 },      /* pm8150a l10 */
+		{ "vdd-3.3-ch1", "ldoc11", 3000 },      /* pm8150a l11 */
+	};
+
+	for (unsigned i = 0; i < sizeof(rails) / sizeof(rails[0]); i++) {
+		bool ok = (rails[i].millivolts == 0 || hakios_mpss_vrm(rails[i].resource, VRM_VOLTAGE, rails[i].millivolts)) &&
+		    hakios_mpss_vrm(rails[i].resource, VRM_MODE, VRM_MODE_HPM) && hakios_mpss_vrm(rails[i].resource, VRM_ENABLE, 1);
+
+		printf("wcn3990: %u: the radio's %s (%s)%s%s: %s\n", step, rails[i].supply, rails[i].resource,
+		    rails[i].millivolts ? ", at " : "", rails[i].millivolts ? (rails[i].millivolts == 1800 ? "1.8 V" :
+		    rails[i].millivolts == 1304 ? "1.304 V" : "3.0 V") : "", ok ? "ON" : "NOT ON (RPMh did not say done)");
+		if (!ok) {
+			return false;
+		}
+		delay_for_interval(1, NSEC_PER_MSEC);
+	}
+	return true;
+}
+
+/* ---- the exchange ------------------------------------------------------------------------------------- */
+
+void
+hakios_wcn3990_exchange(uint32_t step)
+{
+	const struct hakios_qrtr_ops *transport = hakios_mpss_qrtr();
+	struct ind_register_req indications = { 0 };
+	struct ind_register_resp indications_reply = { 0 };
+	struct msa_info_req msa = { 0 };
+	static struct msa_info_resp regions;
+	struct empty_req nothing = { 0 };
+	struct result_resp ready_reply = { 0 };
+	static struct cap_resp target;
+	uint64_t msa_address = MSA_DEFAULT;
+	uint32_t msa_size = MSA_SIZE_DEFAULT, seconds = 15, upto = 6, power = 1;
+	int ret;
+
+	bzero(&wcn, sizeof(wcn));
+	wcn.step = step;
+	wcn.began = now_ms();
+	PE_parse_boot_argn("wcn3990_msa", &msa_address, sizeof(msa_address));
+	PE_parse_boot_argn("wcn3990_msa_size", &msa_size, sizeof(msa_size));
+	PE_parse_boot_argn("wcn3990_ready", &seconds, sizeof(seconds));
+	PE_parse_boot_argn("wcn3990_upto", &upto, sizeof(upto));
+	PE_parse_boot_argn("wcn3990_power", &power, sizeof(power));
+	marks_start();
+	mark();                                 /* 1, white: the exchange has begun */
+	if (transport == NULL) {
+		printf("wcn3990: %u: the modem's link is not up: nothing to talk to\n", step);
+		return;
+	}
+	/* 0: ath10k_hw_power_on(), before anything is said to the firmware */
+	if (power != 0 && !power_on(step)) {
+		printf("wcn3990: %u: THE RADIO IS NOT POWERED: nothing is said to the firmware\n", step);
+		return;
+	}
+	ret = hakios_qmi_handle_init_transport(&handle, WLFW_LARGEST, &wcn_ops, wcn_handlers, transport);
+	if (ret < 0) {
+		printf("wcn3990: %u: no handle on the modem's router: %d\n", step, ret);
+		return;
+	}
+	ret = qmi_add_lookup(&handle, WLFW_SERVICE, WLFW_VERSION, WLFW_INSTANCE);
+	if (ret < 0 || !wait_for(&wcn.server, 5000)) {
+		printf("wcn3990: %u: THE SERVICE (%#x, version %u, instance %u) IS NOT THERE within 5 s (lookup: %d)\n", step,
+		    WLFW_SERVICE, WLFW_VERSION, WLFW_INSTANCE, ret);
+		goto out;
+	}
+	mark();                                 /* 2, red: the service is there */
+
+	/* 1: ath10k_qmi_ind_register_send() */
+	indications.fw_ready_enable_valid = indications.fw_ready_enable = 1;
+	indications.msa_ready_enable_valid = indications.msa_ready_enable = 1;
+	indications.pin_connect_result_enable_valid = indications.pin_connect_result_enable = 1;
+	indications.client_id_valid = 1;
+	indications.client_id = WLFW_CLIENT_ID;
+	if (!ask("which indications we want", WLFW_IND_REGISTER, ind_register_req_ei, &indications, ind_register_resp_ei,
+	    &indications_reply, false)) {
+		goto out;
+	}
+	if (indications_reply.fw_status_valid) {
+		printf("wcn3990: %u:   the firmware's status word: %#llx%s\n", step, (unsigned long long)indications_reply.fw_status,
+		    (indications_reply.fw_status & 1) ? " (it says it is ready already)" : "");
+		wcn.fw_ready = wcn.fw_ready || (indications_reply.fw_status & 1);
+	}
+	mark();                                 /* 3, green: indications registered */
+
+	if (upto < 2) {
+		goto out;
+	}
+
+	/* 2: ath10k_qmi_msa_mem_info_send_sync_msg(), then ath10k_qmi_setup_msa_permissions() */
+	msa.msa_addr = msa_address;
+	msa.size = msa_size;
+	bzero(&regions, sizeof(regions));
+	if (!ask("where the firmware's memory is", WLFW_MSA_INFO, msa_info_req_ei, &msa, msa_info_resp_ei, &regions, false)) {
+		goto out;
+	}
+	mark();                                 /* 4, blue: the firmware has said what it makes of the memory */
+	printf("wcn3990: %u:   %#x bytes at %#llx, made by the firmware into %u regions\n", step, msa_size,
+	    (unsigned long long)msa_address, regions.regions_len);
+	for (uint32_t i = 0; i < regions.regions_len && i < WLFW_MAX_REGIONS; i++) {
+		const struct msa_region *r = &regions.regions[i];
+		static const uint32_t from[] = { VMID_HLOS };
+		/*
+		 * Who is to have it: ath10k's owners first (the modem and the Wi-Fi VM, and for a region that is
+		 * not secure the Wi-Fi's copy engines too), then fewer, since this phone's TrustZone has refused
+		 * every move to a VM other than HLOS and the modem (-2, answer 0x56): the first it takes is kept.
+		 */
+		static const struct {
+			const char *name;
+			uint32_t vmids[4];
+			unsigned count;
+		} owners[2][4] = {
+			{       /* not secure */
+				{ "the modem, the Wi-Fi VM and its copy engines", { VMID_MSS_MSA, VMID_WLAN, VMID_WLAN_CE }, 3 },
+				{ "HLOS, the modem, the Wi-Fi VM and its copy engines", { VMID_HLOS, VMID_MSS_MSA, VMID_WLAN, VMID_WLAN_CE }, 4 },
+				{ "the modem alone", { VMID_MSS_MSA }, 1 },
+				{ "HLOS and the modem", { VMID_HLOS, VMID_MSS_MSA }, 2 },
+			}, {    /* secure */
+				{ "the modem and the Wi-Fi VM", { VMID_MSS_MSA, VMID_WLAN }, 2 },
+				{ "HLOS, the modem and the Wi-Fi VM", { VMID_HLOS, VMID_MSS_MSA, VMID_WLAN }, 3 },
+				{ "the modem alone", { VMID_MSS_MSA }, 1 },
+				{ "HLOS and the modem", { VMID_HLOS, VMID_MSS_MSA }, 2 },
+			},
+		};
+		unsigned taken = 4;
+
+		printf("wcn3990: %u:   region %u: %#x bytes at %#llx, %s\n", step, i, r->size, (unsigned long long)r->region_addr,
+		    r->secure_flag ? "secure" : "not secure");
+		if (r->region_addr < msa_address || r->region_addr + r->size > msa_address + msa_size) {
+			printf("wcn3990: %u:   REGION %u IS OUTSIDE THE MEMORY GIVEN: not handed over, and the exchange ends\n", step, i);
+			goto out;
+		}
+		mark();                         /* 5 (7), yellow (magenta): about to hand region 0 (1) over */
+		for (unsigned o = 0; o < 4 && taken == 4; o++) {
+			const typeof(owners[0][0]) *set = &owners[r->secure_flag ? 1 : 0][o];
+
+			if (hakios_mpss_assign(r->region_addr, r->size, from, 1, set->vmids, set->count)) {
+				taken = o;
+				printf("wcn3990: %u:   region %u handed to %s\n", step, i, set->name);
+			} else {
+				printf("wcn3990: %u:   region %u: TrustZone does not hand it to %s\n", step, i, set->name);
+			}
+		}
+		if (taken == 4) {
+			/*
+			 * HLOS may not have it: the same refusal for the CDSP's region suggests the reserved memory of the
+			 * PIL is not HLOS's here. Asked as from the modem instead, then (wcn3990_keep_going=1, the default)
+			 * not moved at all, in case the firmware can reach it already.
+			 */
+			static const uint32_t from_modem[] = { VMID_MSS_MSA };
+			const typeof(owners[0][0]) *set = &owners[r->secure_flag ? 1 : 0][0];
+			uint32_t keep_going = 1;
+
+			if (hakios_mpss_assign(r->region_addr, r->size, from_modem, 1, set->vmids, set->count)) {
+				printf("wcn3990: %u:   region %u: THE MODEM HAD IT, and TrustZone hands it on to %s\n", step, i, set->name);
+			} else {
+				PE_parse_boot_argn("wcn3990_keep_going", &keep_going, sizeof(keep_going));
+				printf("wcn3990: %u:   TRUSTZONE DOES NOT HAND REGION %u OVER, from HLOS or from the modem: %s\n", step, i,
+				    keep_going ? "left as it is, and the exchange goes on" : "the exchange ends");
+				if (!keep_going) {
+					goto out;
+				}
+			}
+		}
+		mark();                         /* 6 (8), cyan (orange): handed over */
+	}
+
+	if (upto < 3) {
+		goto out;
+	}
+
+	/* 3: ath10k_qmi_msa_ready_send_sync_msg() */
+	if (!ask("the memory is ready", WLFW_MSA_READY, empty_req_ei, &nothing, result_resp_ei, &ready_reply, false)) {
+		goto out;
+	}
+	mark();
+
+	if (upto < 4) {
+		goto out;
+	}
+
+	/* 4: ath10k_qmi_cap_send_sync_msg() */
+	bzero(&target, sizeof(target));
+	if (!ask("what the chip and the firmware are", WLFW_CAP, empty_req_ei, &nothing, cap_resp_ei, &target, false)) {
+		goto out;
+	}
+	mark();
+	printf("wcn3990: %u:   chip %#x of family %#x%s; board id %#x%s; SoC %#x%s\n", step, target.chip_info.chip_id,
+	    target.chip_info.chip_family, target.chip_info_valid ? "" : " (not said)", target.board_info.value,
+	    target.board_info_valid ? "" : " (not said)", target.soc_info.value, target.soc_info_valid ? "" : " (not said)");
+	if (target.fw_version_info_valid) {
+		printf("wcn3990: %u:   firmware version %#x, built %s\n", step, target.fw_version_info.fw_version,
+		    target.fw_version_info.fw_build_timestamp);
+	}
+	if (target.fw_build_id_valid) {
+		printf("wcn3990: %u:   firmware build %s\n", step, target.fw_build_id);
+	}
+	if (upto < 5) {
+		goto out;
+	}
+
+	/* 5: ath10k_qmi_load_board_data(), the board file only (no calibration file) */
+	if (!send_board(target.board_info.value, target.board_info_valid)) {
+		goto out;
+	}
+
+	/* ... and ath10k_qmi_send_cal_report_req(), which Android's cnss-daemon sends next as well ("check for xo cal file") */
+	{
+		struct cal_report_req report = { 0 };
+		struct result_resp report_reply = { 0 };
+
+		if (!ask("which calibration files there are (none)", WLFW_CAL_REPORT, cal_report_req_ei, &report, result_resp_ei,
+		    &report_reply, false)) {
+			goto out;
+		}
+	}
+
+	if (upto < 6) {
+		goto out;
+	}
+
+	/* 6: what ath10k waits for before it powers the driver up */
+	if (wait_for(&wcn.fw_ready, seconds * 1000)) {
+		printf("wcn3990: %u: THE WI-FI FIRMWARE IS READY, %llu ms after the exchange began\n", step, now_ms() - wcn.began);
+	} else {
+		printf("wcn3990: %u: no \"firmware ready\" within %u s (the radio's supplies are as the boot loader left them)\n", step,
+		    seconds);
+	}
+out:
+	mark();                                 /* the last: the exchange is over */
+	printf("wcn3990: %u: over after %llu ms, steps up to %u (MSA ready said %s, pins said %s)\n", step, now_ms() - wcn.began,
+	    upto, wcn.msa_ready ? "yes" : "no", wcn.pins ? "yes" : "no");
+	qmi_handle_release(&handle);
+}
