+/* "these are the calibration files I have": none, as ath10k says it when it has none */
+#define WLFW_CAL_REPORT         0x0026
+#define WLFW_MAX_CAL_FILES      4
+struct cal_report_req {
+	uint32_t meta_data_len;
+	uint32_t meta_data[WLFW_MAX_CAL_FILES];
+};
+static const struct qmi_elem_info cal_report_req_ei[] = {
+	{ QMI_DATA_LEN, 1, sizeof(uint8_t), NO_ARRAY, 0x01, __offsetof(struct cal_report_req, meta_data_len), NULL },
+	{ QMI_UNSIGNED_4_BYTE, WLFW_MAX_CAL_FILES, sizeof(uint32_t), VAR_LEN_ARRAY, 0x01, __offsetof(struct cal_report_req, meta_data),
+	  NULL },
+	EI_END,
+};
