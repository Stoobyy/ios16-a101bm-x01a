+};
+static const struct qmi_elem_info cap_chip_ei[] = {
+	EI_U32(struct cap_chip, chip_id, 0), EI_U32(struct cap_chip, chip_family, 0), EI_END,
+};
+struct cap_one {
+	uint32_t value;
+};
+static const struct qmi_elem_info cap_one_ei[] = { EI_U32(struct cap_one, value, 0), EI_END };
+struct cap_version {
+	uint32_t fw_version;
+	char fw_build_timestamp[WLFW_TIMESTAMP_LEN + 1];
+};
+static const struct qmi_elem_info cap_version_ei[] = {
+	EI_U32(struct cap_version, fw_version, 0),
+	{ QMI_STRING, WLFW_TIMESTAMP_LEN + 1, sizeof(char), NO_ARRAY, 0, __offsetof(struct cap_version, fw_build_timestamp), NULL },
+	EI_END,
+};
+
+struct cap_resp {
+	struct qmi_response_type_v01 resp;
+	uint8_t chip_info_valid;
+	struct cap_chip chip_info;
+	uint8_t board_info_valid;
+	struct cap_one board_info;
+	uint8_t soc_info_valid;
+	struct cap_one soc_info;
+	uint8_t fw_version_info_valid;
+	struct cap_version fw_version_info;
+	uint8_t fw_build_id_valid;
+	char fw_build_id[WLFW_BUILD_ID_LEN + 1];
+};
+static const struct qmi_elem_info cap_resp_ei[] = {
+	EI_RESULT(struct cap_resp),
+	EI_OPT(struct cap_resp, chip_info, 0x10),
+	{ QMI_STRUCT, 1, sizeof(struct cap_chip), NO_ARRAY, 0x10, __offsetof(struct cap_resp, chip_info), cap_chip_ei },
+	EI_OPT(struct cap_resp, board_info, 0x11),
+	{ QMI_STRUCT, 1, sizeof(struct cap_one), NO_ARRAY, 0x11, __offsetof(struct cap_resp, board_info), cap_one_ei },
+	EI_OPT(struct cap_resp, soc_info, 0x12),
+	{ QMI_STRUCT, 1, sizeof(struct cap_one), NO_ARRAY, 0x12, __offsetof(struct cap_resp, soc_info), cap_one_ei },
+	EI_OPT(struct cap_resp, fw_version_info, 0x13),
+	{ QMI_STRUCT, 1, sizeof(struct cap_version), NO_ARRAY, 0x13, __offsetof(struct cap_resp, fw_version_info),
+	  cap_version_ei },
+	EI_OPT(struct cap_resp, fw_build_id, 0x14),
+	{ QMI_STRING, WLFW_BUILD_ID_LEN + 1, sizeof(char), NO_ARRAY, 0x14, __offsetof(struct cap_resp, fw_build_id), NULL },
+	EI_END,
+};
+
+struct bdf_req {
+	uint8_t valid;
+	uint8_t file_id_valid;
+	uint32_t file_id;
+	uint8_t total_size_valid;
+	uint32_t total_size;
+	uint8_t seg_id_valid;
+	uint32_t seg_id;
+	uint8_t data_valid;
+	uint32_t data_len;
+	uint8_t data[WLFW_MAX_DATA];
+	uint8_t end_valid;
+	uint8_t end;
+};
+static const struct qmi_elem_info bdf_req_ei[] = {
+	EI_U8(struct bdf_req, valid, 0x01),
+	EI_OPT(struct bdf_req, file_id, 0x10), EI_U32(struct bdf_req, file_id, 0x10),
+	EI_OPT(struct bdf_req, total_size, 0x11), EI_U32(struct bdf_req, total_size, 0x11),
+	EI_OPT(struct bdf_req, seg_id, 0x12), EI_U32(struct bdf_req, seg_id, 0x12),
+	EI_OPT(struct bdf_req, data, 0x13),
+	{ QMI_DATA_LEN, 1, sizeof(uint16_t), NO_ARRAY, 0x13, __offsetof(struct bdf_req, data_len), NULL },
+	{ QMI_UNSIGNED_1_BYTE, WLFW_MAX_DATA, sizeof(uint8_t), VAR_LEN_ARRAY, 0x13, __offsetof(struct bdf_req, data), NULL },
+	EI_OPT(struct bdf_req, end, 0x14), EI_U8(struct bdf_req, end, 0x14),
+	EI_END,
+};
